# Website URL
SITE_URL=

# Database (Supabase PostgreSQL via Prisma & cloudinary)
# The direct host (db.<project-ref>.supabase.co:5432) is IPv6-only. On an
# IPv4-only network use the Supabase pooler URL instead, e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL= 
# Optional. Direct (non-pooled) connection used by Prisma CLI/Migrate/db push.
# Falls back to DATABASE_URL when unset. Without it, `prisma db push` runs
# through the pgBouncer pooler, which can reject migration statements.
DIRECT_URL=
CLOUDINARY_URL=

# Admin Authentication (.env based)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
